<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
    android:minHeight="58dp" android:orientation="vertical" android:gravity="center">
    <TextView android:id="@+id/metric_title" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textAlignment="center"
        android:textSize="13sp" android:textColor="@color/muted"/>
    <TextView android:id="@+id/metric_value" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:fontFamily="sans-serif-medium"
        android:textSize="19sp" android:textColor="@color/ink"/>
</LinearLayout>
