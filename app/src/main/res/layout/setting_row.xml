<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="3dp"
    android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_tone"
    android:minHeight="70dp" android:clickable="true" android:focusable="true" android:paddingHorizontal="16dp"
    android:paddingVertical="11dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:importantForAccessibility="noHideDescendants">
        <TextView android:id="@+id/setting_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="16sp" android:fontFamily="sans-serif-medium" android:textColor="@color/ink"/>
        <TextView android:id="@+id/setting_value" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textSize="14sp" android:textColor="@color/accent"/>
    </LinearLayout>
    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_marginStart="10dp"
        android:src="@drawable/ic_next" android:importantForAccessibility="no"/>
</LinearLayout>
