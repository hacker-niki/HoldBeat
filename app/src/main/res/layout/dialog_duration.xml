<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="16dp"
    android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:baselineAligned="false">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:labelFor="@+id/minutes" android:text="@string/minutes"/>
            <EditText android:id="@id/minutes" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="number"
                android:importantForAutofill="no" android:maxLength="2" android:selectAllOnFocus="true" android:imeOptions="actionNext"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:labelFor="@+id/seconds" android:text="@string/seconds"/>
            <EditText android:id="@id/seconds" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="number"
                android:importantForAutofill="no" android:maxLength="2" android:selectAllOnFocus="true" android:imeOptions="actionDone"/>
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/duration_error" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp" android:visibility="gone"
        android:accessibilityLiveRegion="polite" android:textColor="#FFB6A2" android:text="@string/duration_error"/>
</LinearLayout>
