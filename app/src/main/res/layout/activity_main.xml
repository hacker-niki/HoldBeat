<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screen"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:scrollbars="none">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="22dp"
        android:paddingTop="14dp" android:paddingBottom="20dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="52dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:gravity="center_vertical" android:fontFamily="sans-serif-medium"
                android:drawableStart="@drawable/ic_mark" android:drawablePadding="11dp"
                android:letterSpacing="-0.03" android:text="@string/app_name"
                android:textColor="@color/ink" android:textSize="21sp"/>
            <Button android:id="@+id/settings" style="@style/TimerButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:drawableStart="@drawable/ic_settings" android:drawablePadding="7dp"
                android:text="@string/settings" android:textColor="@color/muted" android:textSize="14sp"/>
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/line" android:importantForAccessibility="no"/>

        <com.tonechronometer.app.TimerDial
            android:id="@+id/dial" android:layout_width="match_parent"
            android:layout_height="235dp" android:layout_weight="1"
            android:importantForAccessibility="yes" android:focusable="true"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/duration_label" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:fontFamily="sans-serif-medium"
                android:text="@string/duration" android:textColor="@color/ink" android:textSize="18sp"/>
            <Button android:id="@+id/custom" style="@style/TimerButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:drawableStart="@drawable/ic_edit" android:drawablePadding="6dp"
                android:paddingStart="10dp" android:paddingEnd="2dp" android:text="@string/custom"
                android:textColor="@color/accent" android:textSize="14sp"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/presets"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal"/>

        <LinearLayout android:id="@+id/tone_preview"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="54dp" android:layout_marginTop="16dp"
            android:gravity="center_vertical" android:paddingHorizontal="14dp"
            android:background="@drawable/bg_tone" android:clickable="true"
            android:focusable="true" android:contentDescription="@string/preview">
            <ImageView android:layout_width="19dp" android:layout_height="19dp"
                android:importantForAccessibility="no" android:src="@drawable/ic_speaker"/>
            <TextView android:id="@+id/tone_label" android:layout_width="0dp" android:layout_height="wrap_content"
                android:importantForAccessibility="no" android:layout_weight="1"
                android:layout_marginStart="10dp" android:text="@string/tone"
                android:textColor="@color/ink" android:textSize="15sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:importantForAccessibility="no" android:fontFamily="sans-serif-medium"
                android:text="@string/preview" android:textColor="@color/accent"
                android:drawableEnd="@drawable/ic_test" android:drawablePadding="6dp" android:textSize="14sp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="18dp">
            <ImageButton android:id="@+id/reset"
                android:layout_width="54dp" android:layout_height="54dp" android:layout_marginEnd="10dp"
                android:background="@drawable/bg_reset" android:contentDescription="@string/reset"
                android:src="@drawable/ic_reset" android:visibility="gone"/>
            <Button android:id="@+id/primary" style="@style/TimerButton"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:minHeight="54dp" android:background="@drawable/bg_primary"
                android:fontFamily="sans-serif-medium" android:text="@string/start" android:textSize="18sp"
                android:textColor="@color/on_accent"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
